{
  "name": "ember-responsive",
  "version": "5.0.0",
  "description": "An ember-cli addon that gives you a simple, Ember-aware way of dealing with media queries.",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "repository": "https://github.com/freshbooks/ember-responsive",
  "author": "FreshBooks",
  "license": "MIT",
  "scripts": {
    "build": "rollup --config",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input --cache",
    "lint:css:fix": "stylelint \"**/*.css\" --allow-empty-input --fix",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "prepack": "rollup --config",
    "start": "rollup --config --watch",
    "test": "echo \"A v2 addon does not have tests, run tests in test-app\""
  },
  "dependencies": {
    "@ember/string": "^4.0.1",
    "decorator-transforms": "^2.3.2",
    "tracked-built-ins": "^3.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/runtime": "^8.1.3",
    "@ember/test-helpers": "^5.2.2",
    "@embroider/addon-dev": "^8.3.0",
    "@glimmer/component": "^2.1.1",
    "@glimmer/tracking": "^1.1.2",
    "@ijlee2-frontend-configs/ember-template-lint": "^3.0.0",
    "@ijlee2-frontend-configs/eslint-config-ember": "^3.4.0",
    "@ijlee2-frontend-configs/prettier": "^3.1.1",
    "@ijlee2-frontend-configs/stylelint": "^3.1.3",
    "@rollup/plugin-babel": "^7.0.0",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^9.2.1",
    "ember-modifier": "^4.3.0",
    "ember-source": "^6.12.0",
    "ember-template-lint": "^7.9.3",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "prettier-plugin-ember-hbs-tag": "^2.0.5",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "rollup": "^4.60.3",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "14.* || >= 16"
  },
  "ember": {
    "edition": "octane"
  },
  "keywords": [
    "media query"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@ember/test-helpers": ">= 3.0.0"
  },
  "peerDependenciesMeta": {
    "@ember/test-helpers": {
      "optional": true
    }
  }
}
