{
  "name": "test-app",
  "version": "5.0.0",
  "description": "An ember-cli addon that gives you a simple, Ember-aware way of dealing with media queries.",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "repository": "https://github.com/freshbooks/ember-responsive",
  "author": "FreshBooks",
  "license": "MIT",
  "scripts": {
    "build": "ember build --environment=production",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input --cache",
    "lint:css:fix": "stylelint \"**/*.css\" --allow-empty-input --fix",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "ember serve",
    "test": "ember test",
    "test:ember-compatibility": "ember try:one"
  },
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/eslint-plugin": "^7.27.1",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@ember/optional-features": "^2.0.0",
    "@ember/string": "^4.0.1",
    "@ember/test-helpers": "^5.2.2",
    "@embroider/broccoli-side-watch": "^1.1.0",
    "@embroider/test-setup": "^3.0.1",
    "@glimmer/component": "^2.0.0",
    "@glimmer/tracking": "^1.1.2",
    "@ijlee2-frontend-configs/ember-template-lint": "^3.0.0",
    "@ijlee2-frontend-configs/eslint-config-ember": "^3.4.0",
    "@ijlee2-frontend-configs/prettier": "^3.1.1",
    "@ijlee2-frontend-configs/stylelint": "^3.1.3",
    "broccoli-asset-rev": "^3.0.0",
    "concurrently": "^9.2.1",
    "ember-auto-import": "^2.4.2",
    "ember-cli": "^6.12.0",
    "ember-cli-babel": "^8.2.0",
    "ember-cli-dependency-checker": "^3.3.1",
    "ember-cli-htmlbars": "^6.1.0",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-sri": "^2.1.1",
    "ember-cli-terser": "^4.0.2",
    "ember-disable-prototype-extensions": "^1.1.3",
    "ember-load-initializers": "^3.0.1",
    "ember-page-title": "^7.0.0",
    "ember-qunit": "^9.0.3",
    "ember-resolver": "^13.1.0",
    "ember-responsive": "workspace:*",
    "ember-source": "^6.12.0",
    "ember-source-channel-url": "^3.0.0",
    "ember-template-lint": "^7.9.3",
    "ember-try": "^4.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-ember": "^11.0.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-qunit": "^7.3.1",
    "loader.js": "^4.7.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "prettier-plugin-ember-hbs-tag": "^2.0.5",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "qunit": "^2.19.1",
    "qunit-dom": "^3.4.0",
    "sinon": "^21.0.0",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.3",
    "typescript": "^5.9.3",
    "webpack": "^5.74.0"
  },
  "engines": {
    "node": "14.* || >= 16"
  },
  "ember": {
    "edition": "octane"
  },
  "keywords": [
    "media query"
  ],
  "private": true
}
