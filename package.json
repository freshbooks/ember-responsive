{
  "name": "workspace-root",
  "version": "5.0.0",
  "private": true,
  "repository": "",
  "license": "MIT",
  "author": "",
  "scripts": {
    "build": "pnpm --filter ember-responsive build",
    "format": "pnpm --filter \"*\" format",
    "lint": "pnpm --filter \"*\" lint",
    "lint:fix": "pnpm --filter \"*\" lint:fix",
    "prepare": "pnpm build",
    "start": "concurrently \"pnpm:start:*\" --restart-after 5000 --prefix-colors cyan,white,yellow",
    "start:addon": "pnpm --filter ember-responsive start",
    "start:test-app": "pnpm --filter test-app start",
    "test": "pnpm --filter \"*\" test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "engines": {
    "node": "20.* || >= 22",
    "pnpm": ">= 10"
  }
}
